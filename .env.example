# Copia este archivo como ".env" y pega tus API keys gratuitas.

# football-data.org: fixtures, resultados, tablas (5 grandes ligas + Champions).
# Consíguela en: https://www.football-data.org/client/register
FOOTBALL_DATA_API_KEY=

# goal-api.com: corners, faltas y tarjetas por partido (no lo trae football-data.org).
# Fuente principal: 1.000 peticiones/día gratis y 5 temporadas de histórico.
# Regístrate gratis (sin tarjeta) en: https://goal-api.com/signup
GOAL_API_KEY=

# highlightly.net: la misma información, como respaldo si Goal API no responde.
# Opcional. Plan gratis de 100 peticiones/día, sin tarjeta: https://highlightly.net
HIGHLIGHTLY_API_KEY=
